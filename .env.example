# Campus Network Telemetry - Environment Configuration Template
# Copy to .env (never commit .env to Git)

# PostgreSQL (Shared: airflow + campus_telemetry)
POSTGRES_USER=pid_user
POSTGRES_PASSWORD=pid_secret_password
POSTGRES_DB=campus_telemetry
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# MySQL (Master Data)
MYSQL_ROOT_PASSWORD=mysql_root_secret
MYSQL_DATABASE=campus_master
MYSQL_USER=pid_mysql
MYSQL_PASSWORD=pid_mysql_secret
MYSQL_HOST=mysql
MYSQL_PORT=3306

# MongoDB (Raw Telemetry)
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=campus_raw
MONGO_COLLECTION=raw_telemetry

# MQTT & Kafka
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=campus/telemetry/#
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC=campus-telemetry

# Simulator Settings
SIM_SEED=42
SIM_INTERVAL_SEC=1.0
SIM_BACKFILL_DAYS=7
SIM_DIRTY_RATE=0.05
SIM_FLASH_CROWD_ENABLED=true
FLASH_CROWD_EVERY_MIN=20
FLASH_CROWD_DURATION_MIN=5
SIM_LEDGER_PATH=/shared/ledger/injection_ledger.jsonl

# Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW__CORE__FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqDDho=

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
